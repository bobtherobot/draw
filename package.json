{
  "name": "draw",
  "version": "2.0.0",
  "description": "Browser-based vector graphics editor",
  "private": true,
  "scripts": {
    "css": "lessc styles/main.less dist/main.css",
    "css:watch": "chokidar 'styles/**/*.less' -c 'lessc styles/main.less dist/main.css'",
    "serve": "python3 -m http.server 8000",
    "dev": "npm run css && npm run serve & npm run css:watch"
  },
  "devDependencies": {
    "less": "^4.2.0",
    "chokidar-cli": "^3.0.0"
  }
}
